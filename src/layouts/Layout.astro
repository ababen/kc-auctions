---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;

const nav = [
  { href: '/auctions/', label: 'Auctions' },
  { href: '/sell/', label: 'Sell' },
  { href: '/buy/', label: 'Buy' },
  { href: '/about/', label: 'About KC' },
];

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: site.url,
  telephone: '+1-772-732-0289',
  email: site.email,
  image: ogImage,
  founder: { '@type': 'Person', name: 'KC Daniel' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: site.city,
    addressRegion: site.state,
    postalCode: site.zip,
    addressCountry: 'US',
  },
  areaServed: ['Martin County, FL', 'St. Lucie County, FL', 'Treasure Coast, FL', 'South Florida'],
};
const schemas = [business, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b1724" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="topbar">
      <div class="container">
        <span>FL Auctioneer {site.auctioneerLicense} · FL Broker {site.brokerLicense}</span>
        <span class="topbar-links">
          <a href={site.phoneHref}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </span>
      </div>
    </div>
    <header class="site-header" data-header>
      <div class="container">
        <a class="brand" href="/" aria-label="Associate Auctions home">
          <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><rect x="1" y="1" width="38" height="38" rx="8" fill="none" stroke="#D9A441" stroke-width="2"></rect><path d="M11 27 L20 11 L29 27 M15 21 H25" fill="none" stroke="#D9A441" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <span>Associate Auctions</span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="header-ctas">
          <a class="btn btn--outline-dim" href="/#alerts">Auction alerts</a>
          <a class="btn btn--gold" href="/#analysis">Free auction analysis</a>
        </div>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu" data-menu-toggle>
          <span data-icon-open><Icon name="menu" /></span>
          <span data-icon-close hidden><Icon name="close" /></span>
        </button>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/#alerts">Auction alerts</a>
        <a class="btn btn--gold btn--block" href="/#analysis">Free auction analysis</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container cols">
        <div style="flex: 1 1 300px;">
          <span style="font-family: var(--serif); font-size: 22px; font-weight: 700; color: var(--paper);">{site.name}</span>
          <address>
            {site.person}, {site.role}<br />
            {site.street}<br />
            {site.city}, {site.state} {site.zip}<br />
            <a href={site.phoneHref}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a>
          </address>
          <span style="font-size: 14px;">Serving {site.area}.</span>
        </div>
        <div>
          <h3>Auctions</h3>
          <a href="/#alerts">Upcoming auctions</a>
          <a href="/auctions/">Past auctions</a>
        </div>
        <div>
          <h3>Company</h3>
          <a href="/sell/">Selling at auction</a>
          <a href="/buy/">Buying at auction</a>
          <a href="/about/">About KC</a>
          <a href="/#analysis">Contact</a>
        </div>
      </div>
      <div class="container legal">
        <span>© {new Date().getFullYear()} {site.name} · FL Auctioneer {site.auctioneerLicense} · FL Broker {site.brokerLicense}</span>
        <span>{site.city}, Florida</span>
      </div>
    </footer>

    <div class="action-bar">
      <a class="btn btn--outline" href={site.phoneHref}><Icon name="phone" size={18} /> Call KC</a>
      <a class="btn btn--ink" href="/#alerts">Auction alerts</a>
    </div>

    <script>
      const header = document.querySelector('[data-header]');
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const openIcon = document.querySelector<HTMLElement>('[data-icon-open]');
      const closeIcon = document.querySelector<HTMLElement>('[data-icon-close]');
      const setOpen = (open: boolean) => {
        header?.classList.toggle('is-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        if (openIcon) openIcon.hidden = open;
        if (closeIcon) closeIcon.hidden = !open;
      };
      toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
      document.querySelectorAll('#mobile-nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

      // Send form visitors back to our own thank-you page after FormSubmit receives the data.
      document.querySelectorAll<HTMLFormElement>('form[data-next]').forEach((form) => {
        const next = form.querySelector<HTMLInputElement>('input[name="_next"]');
        if (next) next.value = new URL(form.dataset.next ?? '/thanks/', location.origin).toString();
      });
    </script>
  </body>
</html>
