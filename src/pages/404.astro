---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Associate Auctions" description="This page could not be found.">
  <section class="page-head" style="min-height: 50vh;">
    <div class="container">
      <div class="eyebrow">404</div>
      <h1>Going, going… gone.</h1>
      <p class="lead">This page has been sold off. Try one of these instead:</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px;">
        <a class="btn btn--ink" href="/">Home</a>
        <a class="btn btn--outline" href="/auctions/">Auctions</a>
        <a class="btn btn--outline" href="/sell/">Sell at auction</a>
      </div>
    </div>
  </section>
</Layout>
