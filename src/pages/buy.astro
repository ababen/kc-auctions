---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import AlertsForm from '../components/AlertsForm.astro';
import { site } from '../data/site';

const steps = [
  ['Read the terms', 'Every auction page lists the buyer’s premium, the deposit needed to qualify, and the closing timeline. Download the bidder information package for the full contract.'],
  ['Inspect the property', 'Inspection is by appointment. Call or text KC to set a time before auction day.'],
  ['Register to bid', 'Fill out the bidder registration form and bring the qualifying deposit (cash or cashier’s check) on auction day.'],
  ['Bid and close', 'The highest bidder signs the contract and pays a 10% deposit that day. The balance is due at closing, typically within 30 days.'],
];
---
<Layout
  title="Buy at Auction | Associate Auctions, Treasure Coast FL"
  description="How to buy property at an Associate Auctions sale: read the terms, inspect, register, bid. Get alerts the day new Treasure Coast auctions are announced."
>
  <section class="page-head">
    <div class="container">
      <div class="eyebrow">For buyers</div>
      <h1>Bid in the open. Know the rules up front.</h1>
      <p class="lead" style="max-width: 720px;">Auctions sell on a set date with every term published in advance. Here's how it works.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <ol class="steps">
        {steps.map(([t, b], i) => (
          <li class="step">
            <div class="num"><b>{String(i + 1).padStart(2, '0')}</b></div>
            <h3>{t}</h3>
            <p>{b}</p>
          </li>
        ))}
      </ol>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px;">
        <a class="btn btn--ink btn--lg" href="/auctions/">See auction terms &amp; documents <Icon name="arrow" size={18} /></a>
        <a class="btn btn--outline btn--lg" href={site.phoneHref}><Icon name="phone" size={18} /> {site.phone}</a>
      </div>
    </div>
  </section>

  <section id="buy-alerts" class="section--tight">
    <div class="container">
      <div class="panel" style="padding: 36px; display: flex; flex-direction: column; gap: 16px; max-width: 820px;">
        <h2 style="font-size: 30px;">Get first word on new auctions</h2>
        <p class="lead" style="font-size: 17px;">Leave your email or mobile number and you'll hear the day the next auction is announced.</p>
        <AlertsForm />
      </div>
    </div>
  </section>
</Layout>
