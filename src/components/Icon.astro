---
interface Props {
  name: 'check' | 'arrow' | 'phone' | 'pin' | 'doc' | 'land' | 'truck' | 'bike' | 'medal' | 'menu' | 'close' | 'dash';
  size?: number;
  stroke?: string;
}
const { name, size = 22, stroke = 'currentColor' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'check' && <path d="M5 12l5 5 9-10" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'dash' && <path d="M5 12h14" />}
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'pin' && <><path d="M12 22s7-8 7-13a7 7 0 0 0-14 0c0 5 7 13 7 13z" /><circle cx="12" cy="9" r="2.5" /></>}
  {name === 'doc' && <><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M12 12v6M9 15l3 3 3-3" /></>}
  {name === 'land' && <><path d="M3 20h18M5 20l5-9 3 5 2-3 4 7" /><circle cx="17" cy="6" r="2" /></>}
  {name === 'truck' && <><path d="M2 16V8h11v8M13 11h5l3 3v2h-8" /><circle cx="6.5" cy="17" r="2" /><circle cx="17.5" cy="17" r="2" /></>}
  {name === 'bike' && <><circle cx="5" cy="17" r="3" /><circle cx="19" cy="17" r="3" /><path d="M5 17l4-7h5l5 7M9 10l-1-3H6M14 10l2-3h3" /></>}
  {name === 'medal' && <><circle cx="12" cy="9" r="6" /><path d="M8.5 14 7 22l5-3 5 3-1.5-8" /></>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
</svg>
