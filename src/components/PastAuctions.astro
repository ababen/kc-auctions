---
import AuctionCard from './AuctionCard.astro';
import Icon from './Icon.astro';
import { pastAuctions, otherPastAuctions } from '../data/auctions';

interface Props { heading?: 'h1' | 'h2'; limit?: number; filters?: boolean }
const { heading = 'h2', limit, filters = false } = Astro.props;
const shown = limit ? pastAuctions.slice(0, limit) : pastAuctions;
const categories = [...new Set(pastAuctions.map((a) => a.category))];
const H = heading;
---
<section id="past" class="dark section">
  <div class="container">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 48px;">
      <div>
        <div class="eyebrow">The record</div>
        <H class="h2">Going, going… gone.</H>
        <p class="lead" style="margin-top: 12px; max-width: 520px; font-size: 16px;">Land, homes, commercial sites, vehicles and whole estates. A few of the auctions KC has called on the Treasure Coast.</p>
      </div>
      <div class="stats">
        <div class="stat"><strong>20+</strong><span>years in the auction business</span></div>
        <div class="stat"><strong>2nd</strong><span>generation auctioneer</span></div>
        <div class="stat"><strong>2010</strong><span>Florida bid-calling champion</span></div>
      </div>
    </div>
    {filters && (
      <div class="filter-chips" role="group" aria-label="Filter past auctions">
        <button type="button" class="fchip" aria-pressed="true" data-filter="">All ({pastAuctions.length})</button>
        {categories.map((c) => <button type="button" class="fchip" aria-pressed="false" data-filter={c}>{c} ({pastAuctions.filter((a) => a.category === c).length})</button>)}
      </div>
    )}
    <div class="grid-cards" id="past-grid">
      {shown.map((a, i) => <AuctionCard auction={a} delay={Math.min(i, 5) * 0.12} />)}
    </div>
    {limit && pastAuctions.length > limit && (
      <div style="display: flex; justify-content: center; margin-top: 32px;">
        <a class="btn btn--gold btn--lg" href="/auctions/#past">See all {pastAuctions.length} past auctions</a>
      </div>
    )}
    <ul class="mini-list">
      {otherPastAuctions.map((m) => (
        <li class="mini">
          <span class="icon"><Icon name={m.icon} size={26} /></span>
          <span>
            <span class="cat">{m.category}</span>
            <span class="title">{m.title}</span>
            <span class="place">{m.place}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
{filters && (
  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('.fchip');
    const cards = document.querySelectorAll<HTMLElement>('#past-grid .auction-card');
    chips.forEach((chip) => chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach((card) => { card.hidden = !!f && card.dataset.cat !== f; });
    }));
  </script>
)}
