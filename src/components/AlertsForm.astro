---
import { site } from '../data/site';
/* FormSubmit (formsubmit.co) emails each submission to KC. `_next` is filled in by FormRedirect. */
---
<form action={`https://formsubmit.co/${site.email}`} method="POST" data-next="/thanks/?form=alerts" class="form-row" style="align-items: flex-end;">
  <input type="hidden" name="_subject" value="Auction alerts sign-up — associateauctions.com" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value="" />
  <p class="hidden"><label>Leave this empty <input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label></p>
  <label class="field" style="flex: 1 1 260px;">Email or mobile number
    <input type="text" name="contact" autocomplete="email" required />
  </label>
  <button class="btn btn--ink btn--lg" type="submit" style="flex: 0 0 auto;">Notify me</button>
</form>
