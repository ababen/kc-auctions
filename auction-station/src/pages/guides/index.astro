---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../data/guides';
---
<Layout title="Auction Guides: how auctions work | Auction Station" description="Plain-English guides to auction types, buyer’s premiums, hiring a Florida auctioneer, benefit auctions and backup auctioneers.">
  <section class="section--tight dark">
    <div class="container stack">
      <p class="eyebrow">Auction guides</p>
      <h1 class="h1" style="font-size: clamp(40px, 5.5vw, 72px);">All things auctions</h1>
      <p class="lead">Short, plain-English guides for buyers, sellers and event organizers.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid-3">
      {guides.map((g) => (
        <a class="card" href={`/guides/${g.slug}/`}>
          <span class="tag">{g.audience}</span>
          <h2 class="h3" style="font-size: 22px;">{g.title}</h2>
          <p class="muted">{g.summary}</p>
          <span class="more">Read →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
